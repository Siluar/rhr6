rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Donos do sistema (sempre administradores, mesmo se a colecao usuarios
    // ainda nao tiver documentos).
    function isOwner() {
      return isSignedIn() && request.auth.token.email in [
        'imc.sidnei@gmail.com',
        'sidnei@policiapenal.pr.gov.br'
      ];
    }

    // Administrador: dono OU usuario marcado como admin na colecao usuarios
    // (o id do documento e o e-mail).
    function isAdmin() {
      return isOwner() ||
        (isSignedIn()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
          && get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.perfil == 'admin');
    }

    // Solicitacoes de ferias/licencas: qualquer logado le/cria;
    // somente admin aprova, edita ou apaga.
    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Cadastro de servidores e contas de acesso: somente admin.
    match /servidores/{id} {
      allow read, list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contas/{id} {
      allow read, list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Usuarios/contas do Google: o login precisa ler para decidir o perfil;
    // somente admin cria/edita/apaga.
    match /usuarios/{email} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}