rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // E-mails que podem aprovar/recusar (proprietarios/administradores).
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'imc.sidnei@gmail.com',
        'sidnei@policiapenal.pr.gov.br'
      ];
    }

    // Solicitacoes de ferias/licencas.
    match /requests/{requestId} {
      // Qualquer usuario autenticado pode ler e criar solicitacoes.
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Somente o administrador pode aprovar, recusar, editar ou apagar.
      allow update, delete: if isAdmin();
    }
  }
}
