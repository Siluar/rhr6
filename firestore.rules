rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Conta com e-mail institucional (ex.: @policiapenal.pr.gov.br). Entra
    // SEM aprovacao manual: qualquer servidor com esse dominio tem acesso.
    function isDomainUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@policiapenal[.]pr[.]gov[.]br');
    }

    // Donos do sistema (sempre administradores, mesmo se a colecao usuarios
    // ainda nao tiver documentos).
    function isOwner() {
      return isSignedIn() && request.auth.token.email in [
        'imc.sidnei@gmail.com',
        'sidnei@policiapenal.pr.gov.br'
      ];
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email));
    }

    // Usuario ativo: dono OU registro aprovado na colecao usuarios. Documentos
    // antigos (sem o campo ativo e sem pendente) seguem valendo como aprovados.
    function isActiveUser() {
      return hasUserDoc()
        && (userDoc().data.get('ativo', null) == true
            || (userDoc().data.get('ativo', null) == null
                && userDoc().data.get('pendente', null) != true));
    }

    // Usuario aprovado: pode ler/criar solicitacoes.
    function isApproved() {
      return isOwner() || isActiveUser();
    }

    // Quem pode ler/criar solicitacoes: donos, e-mails institucionais (sem
    // aprovacao) e usuarios aprovados manualmente.
    function canUseRequests() {
      return isOwner() || isDomainUser() || isActiveUser();
    }

    // Administrador: dono OU usuario marcado como admin e ativo na colecao
    // usuarios (o id do documento e o e-mail).
    function isAdmin() {
      return isOwner() || (isActiveUser() && userDoc().data.get('perfil', null) == 'admin');
    }

    // Um campo textual opcional, mas limitado a `max` caracteres. Evita que um
    // usuario aprovado grave documentos gigantes ("payload bomb") em requests.
    function isBoundedString(value, max) {
      return value is string && value.size() <= max;
    }

    function optionalBoundedString(data, key, max) {
      return !(key in data) || isBoundedString(data.get(key, null), max);
    }

    // Validacao minima de uma nova solicitacao criada por usuario aprovado.
    // Exigimos que "person" exista e limitamos o tamanho dos campos livres.
    function isValidRequest() {
      let data = request.resource.data;
      return data.person is string
        && data.person.size() > 0
        && data.person.size() <= 120
        && optionalBoundedString(data, 'note', 400)
        && optionalBoundedString(data, 'email', 160)
        && optionalBoundedString(data, 'cpf', 20)
        && optionalBoundedString(data, 'unidade', 160)
        && optionalBoundedString(data, 'funcaoExercida', 160)
        && optionalBoundedString(data, 'substituto', 160)
        && optionalBoundedString(data, 'start', 20)
        && optionalBoundedString(data, 'end', 20)
        && optionalBoundedString(data, 'month', 40)
        && optionalBoundedString(data, 'status', 20)
        && optionalBoundedString(data, 'type', 40)
        && optionalBoundedString(data, 'id', 80);
    }

    // Solicitacoes de ferias/licencas: qualquer e-mail institucional (sem
    // aprovacao) ou usuario aprovado le/cria; somente admin aprova, edita ou
    // apaga. A criacao passa por validacao.
    match /requests/{requestId} {
      allow read: if canUseRequests();
      allow create: if canUseRequests() && isValidRequest();
      allow update, delete: if isAdmin();
    }

    // Cadastro de servidores: somente admin.
    match /servidores/{id} {
      allow read, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Cadastro basico de unidades, cargos e quadros.
    // A LEITURA das unidades e publica: o formulario de solicitacao precisa
    // listar as unidades mesmo antes/independente da sessao (nao ha dado pessoal
    // aqui, apenas os nomes das unidades). A escrita continua restrita ao admin.
    match /unidades/{id} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cargos/{id} {
      allow read, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /quadros/{id} {
      allow read, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Cadastro de servidores com Funcao Gratificada (menu Servidores).
    match /fgServidores/{id} {
      allow read, list: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // Tarefas do painel.
    match /tarefas/{id} {
      allow read, list, create, update, delete: if isAdmin();
    }

    // Anexos das recusas (arquivo em base64; documento limitado a ~700 KB).
    match /anexos/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    // Contas legadas (CPF/senha). Ficam na nuvem apenas como copia de seguranca
    // e restauracao; somente admin le e grava.
    match /contasLegado/{id} {
      allow read, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Usuarios/contas do Google.
    //  - get: apenas o proprio usuario (necessario para decidir o perfil no
    //    login) OU um dono. Evita que um usuario comum leia o cadastro alheio.
    //  - list: apenas aprovados (painel administrativo).
    //  - create: admin OU auto-registro do proprio e-mail — PENDENTE para
    //    contas de fora do dominio, ja ATIVO para e-mail institucional — nunca
    //    com perfil de admin.
    //  - update: admin OU o proprio e-mail institucional atualizando os seus
    //    dados, sem nunca conseguir virar admin.
    match /usuarios/{email} {
      allow get: if isSignedIn()
        && (email == request.auth.token.email || isOwner());
      allow list: if isApproved();
      // create: admin; auto-registro PENDENTE (usuario comum aguardando
      // aprovacao); OU e-mail institucional entrando ja ATIVO e sem aprovacao.
      // Em nenhum caso o proprio usuario pode se criar como admin.
      allow create: if isAdmin()
        || (isSignedIn()
            && email == request.auth.token.email
            && request.resource.data.get('perfil', 'usuario') != 'admin'
            && (
                 (request.resource.data.get('ativo', null) == false
                  && request.resource.data.get('pendente', null) == true)
                 || (isDomainUser()
                     && request.resource.data.get('ativo', null) == true)
               ));
      // update: admin; OU o proprio usuario institucional atualizando os
      // proprios dados, sem nunca virar admin.
      allow update: if isAdmin()
        || (isSignedIn()
            && email == request.auth.token.email
            && isDomainUser()
            && request.resource.data.get('perfil', 'usuario') != 'admin');
      allow delete: if isAdmin();
    }
  }
}
